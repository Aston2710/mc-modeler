{
  "name": "flujo-mcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@supabase/supabase-js": "^2.106.2",
    "bpmn-moddle": "^10.0.0",
    "mcp-handler": "^2.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "typescript": "5.6"
  },
  "description": "Servidor MCP remoto de Flujo (MASTER-PLAN-038). Paquete aislado: no comparte dependencias con la SPA.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:local": "node scripts/build.mjs --local",
    "local": "node scripts/build.mjs --local && node --env-file-if-exists=.env.lab dist/local.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node ../node_modules/vitest/vitest.mjs run --config vitest.config.mjs"
  }
}
